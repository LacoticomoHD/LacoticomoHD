# Supabase-Zugangsdaten (Dashboard → Project Settings → API)
# Diese Datei nach .env kopieren und die Werte eintragen.
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Optional: eigener Karten-Tile-Anbieter für den Produktivbetrieb.
# Ohne diese Variable werden die offiziellen OSM-Server genutzt (nur für Entwicklung/Tests!).
# Beispiel MapTiler (kostenloser Tarif auf maptiler.com):
# EXPO_PUBLIC_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=DEIN_KEY
