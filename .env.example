# Supabase-Zugangsdaten (Dashboard → Project Settings → API)
# Diese Datei nach .env kopieren und die Werte eintragen.
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Optional: eigener Kartenstil für den Produktivbetrieb.
# Ohne diese Variablen werden die offiziellen OSM-Server genutzt (nur für Entwicklung/Tests!).
# Variante 1 (empfohlen): komplette Vektor-Style-URL, z. B. MapTiler (kostenlos auf maptiler.com):
# EXPO_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=DEIN_KEY
# Variante 2: Raster-Tile-URL-Template:
# EXPO_PUBLIC_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=DEIN_KEY
