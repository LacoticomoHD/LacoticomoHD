# Zugangsdaten der App. Datei ".env" daraus erstellen – sie liegt bewusst
# NICHT im Git (siehe .gitignore).
#
# Alle drei Werte landen ohnehin im ausgelieferten Bundle und sind damit
# öffentlich; geschützt werden die Daten durch die Row-Level-Security in der
# Datenbank, nicht durch Geheimhaltung dieses Schlüssels.

EXPO_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<...>
EXPO_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/<stil-id>/style.json?key=<...>
