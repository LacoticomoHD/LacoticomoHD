{
  "expo": {
    "name": "Don Döner",
    "slug": "don-doener",
    "version": "5.4.0",
    "orientation": "portrait",
    "scheme": "dondoener",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.dondoener.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Don Döner nutzt deinen Standort, um Dönerläden in deiner Nähe auf der Karte anzuzeigen."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/LacoticomoHD"
    },
    "android": {
      "package": "de.dondoener.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#130D0A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "versionCode": 55
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#130D0A",
          "dark": {
            "backgroundColor": "#130D0A"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Don Döner nutzt deinen Standort, um Dönerläden in deiner Nähe anzuzeigen."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Don Döner braucht Zugriff auf deine Fotos, damit du Bilder von Dönerläden hochladen kannst.",
          "cameraPermission": "Don Döner braucht die Kamera, damit du Fotos von Dönerläden machen kannst.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
