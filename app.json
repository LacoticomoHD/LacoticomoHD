{
  "expo": {
    "name": "Don Döner",
    "slug": "don-doener",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dondoener",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.dondoener.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Don Döner nutzt deinen Standort, um Dönerläden in deiner Nähe auf der Karte anzuzeigen."
      }
    },
    "android": {
      "package": "de.dondoener.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C0392B"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2",
          "dark": {
            "backgroundColor": "#17130F"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Don Döner nutzt deinen Standort, um Dönerläden in deiner Nähe anzuzeigen."
        }
      ]
    ]
  }
}
